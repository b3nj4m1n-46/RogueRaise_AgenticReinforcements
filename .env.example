# Rogue Raise — environment seams (PRD §14 M0).
# Copy to `.env` for local dev. Every external service is env-driven so WR staff
# swap credentials/providers at merge without touching feature code.

# --- Database -------------------------------------------------------------
# Single DATABASE_URL: local Postgres in dev (docker compose), Neon at merge.
DATABASE_URL="postgres://rogue:rogue@localhost:5433/rogue_raise"

# --- Auth (Better Auth) ---------------------------------------------------
# BOTH are required for the admin console to accept a sign-in. Generate a real
# secret with `npx @better-auth/cli secret`. Better Auth's own tables live in
# `public` (NOT the rogue_raise schema) and are created by:
#     npm run db:auth-migrate
# Create the first WR staff account with:
#     npm run admin:create -- you@whiterabbitashland.com "Your Name"
BETTER_AUTH_SECRET="dev-secret-change-me"
BETTER_AUTH_URL="http://localhost:3000"
# Optional: sets the password `admin:create` uses instead of generating one.
# RR_ADMIN_INITIAL_PASSWORD=""
# Extra event/role scoping layered on Better Auth sessions. External roles
# (sponsor POC, judge, participant, stakeholder) use THIS, not Better Auth
# sessions — see HANDOFF.md for why.
RR_MAGIC_LINK_SECRET="dev-magic-link-secret-change-me"

# --- AI (Vercel AI Gateway) ----------------------------------------------
# With no key, agent runs use a deterministic DEV provider whose output is
# visibly labelled placeholder text; production refuses that provider outright.
AI_GATEWAY_API_KEY=""
RR_AI_MODEL_AUTHORING="anthropic/claude-opus-5"
RR_AI_MODEL_FAST="anthropic/claude-haiku-4-5"

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=""
RR_EMAIL_FROM="Rogue Raise <noreply@example.com>"

# --- File storage (Vercel Blob) ------------------------------------------
# When set, the Vercel Blob provider is selected. When unset, local dev writes
# to RR_LOCAL_BLOB_DIR instead; production REFUSES to start an upload without a
# token rather than writing to an ephemeral filesystem. See HANDOFF.md.
BLOB_READ_WRITE_TOKEN=""
# Local-only file store for intake attachments (gitignored).
RR_LOCAL_BLOB_DIR=".rr-blob"

# --- GitHub App (repo provisioning + LOC/category stats) -----------------
# With no App credentials, repo provisioning uses a LOCAL provider that writes
# the file tree to RR_LOCAL_GITHUB_DIR; production refuses that provider.
RR_GITHUB_ORG="white-rabbit-ashland"
RR_LOCAL_GITHUB_DIR=".rr-github"
RR_GITHUB_APP_ID=""
RR_GITHUB_APP_PRIVATE_KEY=""
RR_GITHUB_APP_INSTALLATION_ID=""

# --- Spam guard (BotID / hCaptcha in prod; honeypot + signed timestamp in dev) --
# Signs the sponsor form challenge; falls back to RR_MAGIC_LINK_SECRET if unset.
RR_SPAM_SECRET="dev-spam-secret-change-me"

# --- Sponsor sign-up notifications ---------------------------------------
# Where WR Admin receives new sponsor-application notifications.
RR_ADMIN_NOTIFY_EMAIL="admin@example.com"

# --- Admin console dev gate (local convenience only) ----------------------
# Skips sign-in entirely so you don't need an account to poke at /admin locally.
# It is IGNORED when NODE_ENV=production — see `isDevOpen()` — so setting it in
# a deployed environment does nothing rather than opening the console. Leave it
# false/unset unless you're on a laptop. Audit rows written while it is on are
# attributed to "wr-admin" rather than to a person.
RR_ADMIN_DEV_OPEN="false"
